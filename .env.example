# ============== 运行环境 ==============
# 可选：local（本地 CPU / 懒加载）、server（服务器 GPU / 预热常驻）
PROFILE=local

# ============== 加载策略 ==============
EAGER_LOAD=false
KEEP_MODELS_RESIDENT=false

# ============== 设备与精度 ==============
# 本地 CPU：TORCH_DEVICE=cpu, TORCH_DTYPE=float32
# 服务器 GPU：TORCH_DEVICE=cuda, TORCH_DTYPE=float16 或 bfloat16
TORCH_DEVICE=cpu
TORCH_DTYPE=float32

# ============== 离线模型目录 ==============
# HF 缓存结构：<MODEL_DIR>/models--<org>--<name>/snapshots/<hash>/
MODEL_DIR=/path/to/MyraidAI-model

# ============== HuggingFace Token ==============
# 离线已缓存模型可留空；如需在线下载受限模型则填入
HF_TOKEN=
